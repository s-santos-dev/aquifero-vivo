POSTGRES_DB=aquifero_vivo
POSTGRES_USER=aquifero
POSTGRES_PASSWORD=aquifero_local
POSTGRES_PORT=5432
# Local execution uses localhost; Compose overrides the host to db.
POSTGRES_HOST=localhost
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=["http://localhost:5173"]
# Public browser URL. Never put secrets in VITE_ variables.
VITE_API_URL=http://localhost:8000

# Dados sintéticos do MVP
DATA_MODE=SIMULATED
SIMULATION_SEED=42
SIMULATION_WELLS=80
SIMULATION_SECTORS=20
SIMULATION_DAYS=730
SIMULATION_SCENARIO=NORMAL
SIMULATION_MIN_LATITUDE=-5.30
SIMULATION_MAX_LATITUDE=-4.90
SIMULATION_MIN_LONGITUDE=-42.95
SIMULATION_MAX_LONGITUDE=-42.60
